# Docker Compose host port; the container always uses port 8089.
LINEAR_PORT=8089
LINEAR_POLL_MS=1500
LINEAR_TIMEOUT_MS=180000
# Optional browser origin, e.g. https://gateway.example.com (no path).
# Set this for an HTTPS reverse proxy to enable Secure administrator cookies.
LINEAR_PUBLIC_URL=

# Client tool calling (OpenAI tools/tool_calls) through a structured-output adapter.
# structured (default, experimental) or off (old text-only behaviour: tools ignored).
LINEAR_CLIENT_TOOLS=structured
# incremental: forward text that is already stable while polling; buffered: one final chunk.
LINEAR_STREAM_MODE=incremental
# native: continue the same Linear conversation during a tool loop; replay: new conversation per request.
LINEAR_TOOL_CONTINUATION=native
# Extra Linear turns used to fix an invalid tool call before failing (0-3).
LINEAR_TOOL_REPAIR_ATTEMPTS=1
# Concurrency: global running requests, per Linear account, and running+queued requests.
LINEAR_MAX_CONCURRENCY=4
LINEAR_ACCOUNT_CONCURRENCY=1
LINEAR_MAX_QUEUE=8
# Transcript format, strict handling of unsupported sampling/length fields, and size limits.
LINEAR_PROMPT_FORMAT=rich
LINEAR_STRICT_PARAMETERS=0
LINEAR_MAX_BODY_BYTES=8388608
LINEAR_MAX_PROMPT_CHARS=1000000
# Hash-only tool session/dispatch records and memory-only completed-reply cache.
LINEAR_TOOL_SESSION_TTL_SECONDS=86400
LINEAR_IDEMPOTENCY_SECONDS=300

# Realtime body channel (Linear's sync WebSocket) for streamed replies: ws (default) or off.
# off = poll GraphQL only (the 0.11.0 behaviour). Failures always fall back to polling.
LINEAR_REALTIME=ws
# conversation: subscribe to the conversation and filter the accepted assistant turn.
# turn: optional AiConversationTurn subscription (some real HTML turns publish no events).
LINEAR_REALTIME_SUBSCRIPTION=conversation
# Must stay a wss:// URL on a linear.app host (the session cookie is sent there).
LINEAR_REALTIME_URL=wss://sync.linear.app/
# Fallback hshk clientVersion for accounts whose captured headers lack linear-client-version.
# Leave empty normally; the browser extension captures the current value.
LINEAR_REALTIME_CLIENT_VERSION=
# GraphQL poll interval while answer text is actively streaming (completion/error checks).
LINEAR_REALTIME_POLL_MS=3000
LINEAR_REALTIME_CONNECT_TIMEOUT_MS=5000
LINEAR_REALTIME_MAX_MESSAGE_BYTES=4194304
# One JSON log line per request with timings and fallback reasons (no content): 1 or 0.
LINEAR_TIMING_LOG=1
